# Docker runtime environment for the backend container.

# Use the committed baseline config by default.
PPX_CONFIG_FILE=./config/default.toml

# Required when the container needs to call a real model provider.
PPX_LLM__API_KEY=

# Override this if MinerU runs outside the compose network.
PPX_MINERU__BASE_URL=http://host.docker.internal:7860

# Optional runtime overrides
# PPX_API__PORT=8000
# PPX_DATA_PROCESS__WORKER_COUNT=2
