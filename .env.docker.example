# Docker runtime environment for the backend container.
#
# NOTE: This file only controls ServerConfig (startup-level fields).
# LLM Provider, Agent LLM binding, MinerU, and Data Process settings
# are managed via the Settings API at runtime and persisted to
# data/app_settings.toml inside the container.
#
# After first start, configure them via:
#   - the console UI at http://<host>:8000/settings
#   - or the Settings REST API
#
# Copy this file to .env.docker and customize as needed.

# Use the committed baseline config by default.
PPX_CONFIG_FILE=./config/default.toml

# ServerConfig overrides (uncomment as needed)
# PPX_API__HOST=0.0.0.0
# PPX_API__PORT=8000
# PPX_DATA_DIR=/app/data
# PPX_LOG__LEVEL=INFO
