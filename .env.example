# Optional: choose a custom TOML config file.
# If not set, backend uses config/default.toml.
PPX_CONFIG_FILE=./config/dev.toml

# Optional: avoid startup timeout when LiteLLM fetches remote model price map.
LITELLM_LOCAL_MODEL_COST_MAP=true

# NOTE: LLM provider / agent LLM binding / MinerU / data_process / librarian
# are NOT configured here. They are managed via the Settings API at runtime
# and persisted to data/app_settings.toml.
#
# After first start, configure them via:
#   - the console UI at http://127.0.0.1:8000/settings
#   - or the Settings REST API (see docs/architecture.md)
#
# The only fields supported in this file are ServerConfig startup fields:
#   PPX_API__HOST, PPX_API__PORT, PPX_API__RELOAD,
#   PPX_DATA_DIR, PPX_DATABASE_PATH, PPX_PROMPTS_DIR,
#   PPX_LOG__LEVEL, PPX_LOG__TO_FILE, etc.
# See config/default.toml for the full list.
